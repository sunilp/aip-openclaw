{
  "name": "aip-openclaw",
  "version": "0.1.0",
  "description": "AIP security plugin for OpenClaw: skill signing, capability manifests, runtime enforcement",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aip-openclaw": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aip-sdk/core": "^0.1.0",
    "@aip-sdk/mcp": "^0.1.0",
    "@aip-sdk/token": "^0.1.0",
    "commander": "^12.1.0",
    "multiformats": "^13.4.2",
    "picomatch": "^4.0.0",
    "smol-toml": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^3.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "files": ["dist", "skill", "aip-manifest.example.toml"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/sunilp/aip-openclaw.git"
  },
  "author": "Sunil Prakash"
}
