{
  "name": "aip-openclaw",
  "version": "0.1.0",
  "description": "AIP security plugin for OpenClaw: skill signing, capability manifests, runtime enforcement",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aip-openclaw": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aip-protocol/core": "file:../aip-node/packages/core",
    "@aip-protocol/mcp": "file:../aip-node/packages/mcp",
    "@aip-protocol/token": "file:../aip-node/packages/token",
    "commander": "^12.1.0",
    "multiformats": "^13.4.2",
    "picomatch": "^4.0.0",
    "smol-toml": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/picomatch": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "license": "Apache-2.0"
}
